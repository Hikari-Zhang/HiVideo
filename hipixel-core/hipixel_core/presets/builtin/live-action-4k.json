{
  "$schema": "https://hipixel.dev/schemas/preset/v1.json",
  "id": "live-action-4k",
  "name": "Live Action 4K",
  "description": "Upscale live-action HD footage to 4K via two-pass 2×+2× Real-ESRGAN. Best for 1080p → 4K.",
  "filters": [
    {
      "filter": "nafnet",
      "params": {
        "strength": 0.5,
        "model": "NAFNet-REDS-width64",
        "tile_size": 256
      }
    },
    {
      "filter": "real_esrgan",
      "params": {
        "scale": 2,
        "model": "RealESRGAN_x2plus",
        "tile_size": 256,
        "tile_padding": 16
      }
    },
    {
      "filter": "real_esrgan",
      "params": {
        "scale": 2,
        "model": "RealESRGAN_x2plus",
        "tile_size": 128,
        "tile_padding": 16
      }
    },
    {
      "filter": "cas",
      "params": {
        "sharpness": 0.5
      }
    }
  ],
  "output": {
    "resolution": "4x",
    "fps": "preserve",
    "codec": "h265",
    "crf": 18,
    "container": "mp4"
  },
  "requirements": {
    "min_vram_mb": 8192,
    "recommended_vram_mb": 16384
  }
}
