{
  "$schema": "https://hipixel.dev/schemas/preset/v1.json",
  "id": "anime-enhance-2x",
  "name": "Anime Enhance 2×",
  "description": "High-quality 2× upscaling for anime and cel-shaded content using Real-ESRGAN.",
  "filters": [
    {
      "filter": "nafnet",
      "params": {
        "strength": 0.3,
        "model": "NAFNet-REDS-width64",
        "tile_size": 256
      }
    },
    {
      "filter": "real_esrgan",
      "params": {
        "scale": 2,
        "model": "RealESRGAN_x2plus",
        "tile_size": 512,
        "tile_padding": 16
      }
    },
    {
      "filter": "cas",
      "params": {
        "sharpness": 0.3
      }
    }
  ],
  "output": {
    "resolution": "2x",
    "fps": "preserve",
    "codec": "h265",
    "crf": 16,
    "container": "mp4"
  },
  "requirements": {
    "min_vram_mb": 3072,
    "recommended_vram_mb": 6144
  }
}
