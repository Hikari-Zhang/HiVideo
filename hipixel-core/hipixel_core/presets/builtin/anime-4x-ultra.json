{
  "$schema": "https://hipixel.dev/schemas/preset/v1.json",
  "id": "anime-4x-ultra",
  "name": "Anime 4× Ultra",
  "description": "Maximum quality 4× upscale for anime. Two-pass Real-ESRGAN (2×+2×). High VRAM requirement.",
  "filters": [
    {
      "filter": "nafnet",
      "params": {
        "strength": 0.3,
        "model": "NAFNet-REDS-width64",
        "tile_size": 256
      }
    },
    {
      "filter": "real_esrgan",
      "params": {
        "scale": 4,
        "model": "RealESRGAN_x4plus",
        "tile_size": 512,
        "tile_padding": 32
      }
    },
    {
      "filter": "cas",
      "params": {
        "sharpness": 0.25
      }
    }
  ],
  "output": {
    "resolution": "4x",
    "fps": "preserve",
    "codec": "h265",
    "crf": 15,
    "container": "mp4"
  },
  "requirements": {
    "min_vram_mb": 8192,
    "recommended_vram_mb": 16384
  }
}
